import { readFile, stat } from "node:fs/promises";
import { resolve } from "node:path";
import {
  monthlyFromDaily,
  normalizedToDaily
} from "../automation/lib/dashboard.mjs";

const root = resolve(".");
const html = await readFile(resolve(root, "index.html"), "utf8");
const connector = await readFile(resolve(root, "js/sharepoint.js"), "utf8");
const seedDashboard = JSON.parse(
  await readFile(
    resolve(
      root,
      "sharepoint-seed/Tikee Adoption 360/publicado/dashboard.json"
    ),
    "utf8"
  )
);
const requiredFiles = [
  "index.html",
  "config.js",
  "css/backend.css",
  "js/sharepoint.js",
  "vendor/msal-browser.min.js",
  "automation/process-sharepoint.mjs",
  "automation/lib/dashboard.mjs",
  "automation/lib/report-schema.mjs",
  "sharepoint-seed/Tikee Adoption 360/publicado/dashboard.json",
  ".github/workflows/pages.yml",
  ".github/workflows/sharepoint-sync.yml",
  "docs/DEPLOYMENT.md",
  "docs/ENTRA_SHAREPOINT.md",
  "docs/POWER_AUTOMATE.md"
];

for (const file of requiredFiles) {
  await stat(resolve(root, file));
}

const inlineScripts = [
  ...html.matchAll(/<script(?![^>]*\bsrc=)[^>]*>([\s\S]*?)<\/script>/gi)
].map((match) => match[1]);
inlineScripts.forEach((source, index) => {
  try {
    new Function(source);
  } catch (error) {
    throw new Error(`Script HTML ${index + 1}: ${error.message}`);
  }
});
new Function(connector);

const normalizedSample = {
  fecha_emision: "2026-07-28",
  usuarios: [
    {
      nombre_ifi: "IFI Demo",
      usuarios_activos: 80,
      usuarios_activos_dia: 3,
      total_usuarios: 100
    }
  ],
  transferencias: [
    {
      nombre_ifi: "IFI Demo",
      internas_numero_web: 2,
      internas_monto_web: 20,
      internas_numero_movil: 3,
      internas_monto_movil: 30,
      externas_numero_web: 0,
      externas_monto_web: 0,
      externas_numero_movil: 0,
      externas_monto_movil: 0,
      tarjetas_numero_web: 0,
      tarjetas_monto_web: 0,
      tarjetas_numero_movil: 0,
      tarjetas_monto_movil: 0,
      numero_web: 2,
      monto_web: 20,
      numero_movil: 3,
      monto_movil: 30,
      total_numero_canales: 5,
      total_monto_canales: 50
    }
  ],
  pagos_servicios: [
    {
      nombre_ifi: "IFI Demo",
      numero_web: 1,
      monto_web: 10,
      numero_movil: 1,
      monto_movil: 10,
      total_numero_canales: 2,
      total_monto_canales: 20
    }
  ],
  advertencias: []
};
const dailySample = {
  [normalizedSample.fecha_emision]: normalizedToDaily(normalizedSample)
};
const monthlySample = monthlyFromDaily(dailySample);
if (
  monthlySample["Julio 2026"].totalTransacciones !== 7 ||
  monthlySample["Julio 2026"].totalVolumen !== 70
) {
  throw new Error("La consolidación mensual no coincide con el contrato.");
}

const checks = [
  {
    ok: /var DIARIO_DATA = \{\};/.test(html),
    message: "La base diaria no debe quedar embebida en index.html."
  },
  {
    ok: /var datosHistoricos = \{\};/.test(html),
    message: "La base mensual no debe quedar embebida en index.html."
  },
  {
    ok: !/var DIARIO_DATA = \{"\d{4}-\d{2}-\d{2}"/.test(html),
    message: "Se detectaron registros diarios dentro del HTML."
  },
  {
    ok: !/xlsx\.full\.min\.js/i.test(html),
    message: "El frontend no debe depender de carga Excel."
  },
  {
    ok: (html.match(/@page\{size:A4 portrait/g) || []).length >= 3,
    message: "Faltan reglas de impresión A4 vertical."
  },
  {
    ok:
      (html.match(/format:\s*['"]a4['"]/gi) || []).length >= 3 &&
      (html.match(/orientation:\s*['"]portrait['"]/gi) || []).length >= 3,
    message: "Las exportaciones PDF deben usar A4 vertical."
  },
  {
    ok: !/orientation\s*:\s*['"]landscape/i.test(html),
    message: "Existe una exportación PDF horizontal."
  },
  {
    ok:
      html.includes('<script src="config.js"></script>') &&
      html.includes('<script src="vendor/msal-browser.min.js"></script>') &&
      html.includes('<script src="js/sharepoint.js"></script>'),
    message: "No está cargado el conector Microsoft 365 / SharePoint."
  },
  {
    ok:
      seedDashboard &&
      typeof seedDashboard.daily === "object" &&
      typeof seedDashboard.monthly === "object" &&
      Array.isArray(seedDashboard.ingestions),
    message: "El dashboard inicial de SharePoint no cumple el contrato."
  },
  {
    ok: !/supabase/i.test(
      html + connector + JSON.stringify(seedDashboard)
    ),
    message: "Persisten referencias al backend anterior."
  }
];

const failed = checks.filter((check) => !check.ok);
if (failed.length) {
  throw new Error(failed.map((check) => check.message).join("\n"));
}

console.log(
  `Validación correcta: ${inlineScripts.length} scripts HTML, SharePoint desacoplado, consolidación mensual y 3 exportaciones A4 vertical.`
);
